 Tabela Loja
CREATE TABLE loja (
    id_loja BIGINT PRIMARY KEY,
    nome VARCHAR(255) NOT NULL,
    endereco VARCHAR(255) NOT NULL,
    cnpj VARCHAR(18) NOT NULL
);

 Tabela Estilo
CREATE TABLE estilo (
    id_estilo BIGINT PRIMARY KEY,
    nome VARCHAR(100) NOT NULL,
    descricao TEXT
);

 Tabela Colecao
CREATE TABLE colecao (
    id_colecao BIGINT PRIMARY KEY,
    nome VARCHAR(150) NOT NULL,
    estacao VARCHAR(50),
    ano INT NOT NULL
);

 Tabela Roupa
CREATE TABLE roupa (
    id_roupa BIGINT PRIMARY KEY,
    nome VARCHAR(255) NOT NULL,
    genero VARCHAR(50),
    tamanho VARCHAR(10) NOT NULL,
    preco DECIMAL(10,2) NOT NULL,
    id_estilo BIGINT NOT NULL,
    id_colecao BIGINT,
    FOREIGN KEY (id_estilo) REFERENCES estilo(id_estilo),
    FOREIGN KEY (id_colecao) REFERENCES colecao(id_colecao)
);

